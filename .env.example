# ============ 应用 ============
APP_ENV=dev
APP_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID
APP_NAME=Hello World Backend
VERSION=0.1.0

# ============ 数据库与 Redis ============
# 注意：数据库与 Redis 的连接参数均为【服务器本地时间】语义，不使用 UTC
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
SQLITE_BUSY_TIMEOUT_MS=30000
REDIS_URL=redis://127.0.0.1:6379/0

# ============ 安全 ============
# 生产环境必须设置强随机值，缺失或仍为示例值将直接拒绝启动
APP_SECRET=dev-please-change-me
CREDENTIAL_ENCRYPTION_KEYS=
SESSION_TTL_SECONDS=604800
CSRF_COOKIE_NAME=hw_csrf
COOKIE_SECURE=false
SESSION_COOKIE_NAME=hw_session
COOKIE_SAMESITE=lax

# ============ SMTP（验证码邮件）============
# EMAIL_PROVIDER=fake 表示开发模式，验证码直接输出到控制台；改为 smtp 表示真实发信
EMAIL_PROVIDER=fake
SMTP_HOST=smtp.qq.com        # QQ 邮箱为 smtp.qq.com
SMTP_PORT=465                # 465=SSL；587=STARTTLS
SMTP_TLS=SSL                 # NONE / SSL / STARTTLS
SMTP_USERNAME=yourname@qq.com
SMTP_PASSWORD=你的16位授权码
SMTP_FROM=yourname@qq.com
SMTP_CONNECT_TIMEOUT=10

# ============ 文本与搜索 ============
TEXT_PROVIDER=fake
TEXT_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=
TEXT_TIMEOUT=60
SEARCH_ENABLED=false
SEARCH_BASE_URL=
SEARCH_API_KEY=
SEARCH_TIMEOUT=15
SEARCH_MAX_CALLS=3

# ============ 存储与限制 ============
STORAGE_ROOT=./data
UPLOAD_DIR=./data/uploads
VIDEO_DIR=./data/videos
TEMP_DIR=./data/tmp
IMAGE_MAX_BYTES=10485760       # 10MB
VIDEO_MAX_BYTES=524288000      # 500MB
AUDIO_MAX_BYTES=104857600      # 100MB
IMAGE_MAX_PIXELS=12000000
SIGNED_URL_TTL_SECONDS=600
RESULT_RETENTION_DAYS=30
MAX_VIDEO_JOBS_PER_USER=3
